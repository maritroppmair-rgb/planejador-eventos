rules_version = '2';
// Planejador de Eventos · Feashion
// - Só quem está em "permitidos" (ou é o DEV) lê qualquer coisa.
// - O que cada um pode fazer depende do cargo, gravado no próprio perfil (membros/{uid}):
//     DEV e Diretor(a): tudo.
//     Coordenador(a) e Membro(a): editam e excluem dados de eventos; não mexem em Parâmetros, Membros e acesso.
//     Trainee: edita dados de eventos, mas não exclui; não mexe em Parâmetros, Membros e acesso.
//     Sem cargo: só visualiza (e edita o próprio perfil).
// - Cada pessoa edita o próprio perfil, mas não o próprio cargo. Só a diretoria atribui cargos.
// No console, troque EMAIL_DO_DEV@usp.br pelo e-mail do DEV.
service cloud.firestore {
  match /databases/{database}/documents {
    function emailLogado() {
      return request.auth.token.email.lower();
    }
    function logadoComEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }
    function ehDev() {
      return logadoComEmail() && emailLogado() == 'EMAIL_DO_DEV@usp.br';
    }
    function liberado() {
      return logadoComEmail() && (
        ehDev()
        || exists(/databases/$(database)/documents/permitidos/$(emailLogado()))
      );
    }
    function meuCargo() {
      let m = /databases/$(database)/documents/membros/$(request.auth.uid);
      return exists(m) ? get(m).data.get('cargo', '') : '';
    }
    function diretoria() {
      return liberado() && (ehDev() || meuCargo() == 'Diretor(a)');
    }
    function podeEditar() {
      return liberado() && (ehDev() || meuCargo() in ['Diretor(a)', 'Coordenador(a)', 'Membro(a)', 'Trainee']);
    }
    function podeExcluir() {
      return liberado() && (ehDev() || meuCargo() in ['Diretor(a)', 'Coordenador(a)', 'Membro(a)']);
    }
    function cargoNovo() {
      return request.resource.data.get('cargo', '');
    }
    function cargoAntigo() {
      return resource.data.get('cargo', '');
    }
    function cargoAtribuivel() {
      return cargoNovo() in ['', 'Diretor(a)', 'Coordenador(a)', 'Membro(a)', 'Trainee'];
    }

    // perfis
    match /membros/{uid} {
      allow read: if liberado();
      // perfil novo: sempre sem cargo (o DEV cria o dele já como DEV)
      allow create: if liberado() && request.auth.uid == uid
        && (cargoNovo() == '' || (cargoNovo() == 'DEV' && ehDev()));
      allow update: if liberado() && (
        // a própria pessoa: edita tudo, menos o cargo
        (request.auth.uid == uid && cargoNovo() == cargoAntigo())
        // o DEV: tudo; o cargo DEV só nele mesmo
        || (ehDev() && (cargoAtribuivel() || (cargoNovo() == 'DEV' && request.auth.uid == uid)))
        // a diretoria: só o cargo de outra pessoa, nunca o do DEV
        || (diretoria() && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cargo', 'cargoPor', 'cargoEm'])
            && cargoAntigo() != 'DEV' && cargoAtribuivel())
      );
      allow delete: if diretoria() && (cargoAntigo() != 'DEV' || ehDev());
    }

    // perfis vindos de um backup: a diretoria grava; cada pessoa lê e apaga o seu ao entrar
    match /perfisImportados/{email} {
      allow read: if liberado();
      allow create, update: if diretoria();
      allow delete: if diretoria() || (liberado() && email == emailLogado());
    }

    // lista de acesso, parâmetros e quem é o DEV: só a diretoria
    match /permitidos/{email} {
      allow read: if liberado();
      allow write: if diretoria() || (ehDev() && email == emailLogado());
    }
    match /parametros/{doc} {
      allow read: if liberado();
      allow write: if diretoria();
    }
    match /config/{doc} {
      allow read: if liberado();
      allow write: if ehDev() && (doc != 'dev' || request.resource.data.email == emailLogado());
    }

    // dados de eventos: eventos, salas, calendário, convidados, listas, documentos e arquivos
    match /{colecao}/{documento=**} {
      allow read: if liberado();
      allow create, update: if podeEditar()
        && !(colecao in ['membros', 'perfisImportados', 'permitidos', 'parametros', 'config']);
      allow delete: if podeExcluir()
        && !(colecao in ['membros', 'perfisImportados', 'permitidos', 'parametros', 'config']);
    }
  }
}
